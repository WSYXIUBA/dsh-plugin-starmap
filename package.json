{
  "name": "dsh-plugin-constellation",
  "description": "DSH 插件星座图 — 侧边栏/设置入口打开依赖关系图，自动分类 + 真实依赖关系网 · Plugin constellation graph for DeepSeek Harness",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSYXIUBA/dsh-plugin-constellation.git"
  },
  "homepage": "https://github.com/WSYXIUBA/dsh-plugin-constellation",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "graph",
    "constellation",
    "dependency"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "build": "node build.mjs",
    "check": "npm run typecheck && npm run build",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "@types/react": "^18.3.3",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./client/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md"
  ]
}